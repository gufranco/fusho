#compdef fusho

_fusho() {
  local -a commands
  commands=(
    'send:encrypt a message to one or more people'
    'read:decrypt a message'
    'keys:list the keys someone publishes'
    'doctor:check the tools fusho needs'
    'version:print the version and the encryption engine'
    'help:print usage'
  )

  if (( CURRENT == 2 )); then
    _describe 'command' commands
    return
  fi

  case "${words[2]}" in
    send)
      _arguments \
        '*--to[add a recipient]:target:' \
        '*--keys-file[add recipients from a public key file]:file:_files' \
        '--key[encrypt to one key, chosen by fingerprint prefix]:prefix:' \
        '--json[print machine readable output]' \
        '--sign[sign as a user whose published key you hold]:user:' \
        '--accept-new-key[accept a recipient whose pinned keys changed]' \
        '--qr[print the message as a QR code]' \
        '--expires[mark the message stale after a duration]:duration:' \
        '--no-banner[omit the note telling the recipient what this is]' \
        '--no-clipboard[do not copy the result to the clipboard]'
      ;;
    read)
      _arguments \
        '--identity[decrypt with a specific private key]:file:_files' \
        '--identity-command[read the private key from a command]:command:' \
        '--clipboard[read the message from the clipboard]' \
        '--require-signature[refuse a message that carries no signature]' \
        '--ignore-expiry[open a message the sender marked as expired]' \
        '*:file:_files'
      ;;
  esac
}

_fusho "$@"
