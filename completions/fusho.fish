complete -c fusho -f
complete -c fusho -n __fish_use_subcommand -a send -d 'encrypt a message to one or more people'
complete -c fusho -n __fish_use_subcommand -a read -d 'decrypt a message'
complete -c fusho -n __fish_use_subcommand -a keys -d 'list the keys someone publishes'
complete -c fusho -n __fish_use_subcommand -a doctor -d 'check the tools fusho needs'
complete -c fusho -n __fish_use_subcommand -a version -d 'print the version and the encryption engine'
complete -c fusho -n __fish_use_subcommand -a help -d 'print usage'

complete -c fusho -n '__fish_seen_subcommand_from send' -l to -r -d 'add a recipient'
complete -c fusho -n '__fish_seen_subcommand_from send' -l keys-file -r -F -d 'add recipients from a public key file'
complete -c fusho -n '__fish_seen_subcommand_from send' -l key -r -d 'encrypt to one key, chosen by fingerprint prefix'
complete -c fusho -n '__fish_seen_subcommand_from send' -l json -d 'print machine readable output'
complete -c fusho -n '__fish_seen_subcommand_from send' -l sign -r -d 'sign as a user whose published key you hold'
complete -c fusho -n '__fish_seen_subcommand_from send' -l accept-new-key -d 'accept a recipient whose pinned keys changed'
complete -c fusho -n '__fish_seen_subcommand_from send' -l qr -d 'print the message as a QR code'
complete -c fusho -n '__fish_seen_subcommand_from send' -l expires -r -d 'mark the message stale after a duration'
complete -c fusho -n '__fish_seen_subcommand_from send' -l no-banner -d 'omit the note telling the recipient what this is'
complete -c fusho -n '__fish_seen_subcommand_from send' -l no-clipboard -d 'do not copy the result to the clipboard'

complete -c fusho -n '__fish_seen_subcommand_from read' -l identity -r -F -d 'decrypt with a specific private key'
complete -c fusho -n '__fish_seen_subcommand_from read' -l identity-command -r -d 'read the private key from a command'
complete -c fusho -n '__fish_seen_subcommand_from read' -l clipboard -d 'read the message from the clipboard'
complete -c fusho -n '__fish_seen_subcommand_from read' -l require-signature -d 'refuse a message that carries no signature'
complete -c fusho -n '__fish_seen_subcommand_from read' -l ignore-expiry -d 'open a message the sender marked as expired'
